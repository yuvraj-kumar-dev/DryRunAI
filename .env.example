# Copy this file to .env and fill in real values. Never commit .env itself.

# Deepgram Flux (speech-to-text) + Aura-2 (text-to-speech), orchestrated via Pipecat —
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# Groq (live conversational LLM + scorecard LLM) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Not needed for v0. Only set this if Groq's quality proves inadequate and you switch
# the live conversation and/or scorecard over to Claude Sonnet 5 (see docs/architecture.md).
ANTHROPIC_API_KEY=

# Backend
BACKEND_PORT=8000

# Frontend (points the browser at the local backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
